cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED DEPLOY_SCRIPT OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "需要部署脚本和独立测试目录")
endif()
# 只生成本测试的假库，不读取或写入应用运行目录。
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(fixture "${TEST_ROOT}/${run_id}")
set(destination "${fixture}/deployed")
file(MAKE_DIRECTORY "${fixture}")
set(runtime "${fixture}/Qt6QuickTemplates2d.dll")
function(write_manifest version configuration sha patch)
    file(WRITE "${runtime}.json"
        "{\"qtVersion\":\"${version}\",\"configuration\":\"${configuration}\",\"runtimeSha256\":\"${sha}\",\"patch\":\"${patch}\"}")
endfunction()
function(check_deployment label should_succeed)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DFIX_DIR=${fixture}"
        "-DTARGET_DIR=${destination}" -DQT_VERSION=6.4.3 -DCONFIG=Debug
        -P "${DEPLOY_SCRIPT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(should_succeed AND NOT result EQUAL 0)
        message(FATAL_ERROR "${label}意外失败：${output} ${error}")
    elseif(NOT should_succeed AND result EQUAL 0)
        message(FATAL_ERROR "${label}未被拒绝")
    endif()
    message(STATUS "${label}：通过")
endfunction()
set(patch "APP-001-scrollbar-unique-connection-v1")
check_deployment("缺库" FALSE)
file(WRITE "${runtime}" "仅为部署校验的合成测试库，不可执行")
check_deployment("缺清单" FALSE)
file(SHA256 "${runtime}" sha)
write_manifest("6.8.0" "Debug" "${sha}" "${patch}")
check_deployment("错误Qt版本" FALSE)
write_manifest("6.4.3" "Release" "${sha}" "${patch}")
check_deployment("错误构建配置" FALSE)
write_manifest("6.4.3" "Debug" "${sha}" "未知补丁")
check_deployment("错误补丁身份" FALSE)
write_manifest("6.4.3" "Debug" "bad-sha" "${patch}")
check_deployment("库哈希不符" FALSE)
write_manifest("6.4.3" "Debug" "${sha}" "${patch}")
check_deployment("匹配库与清单" TRUE)
file(SHA256 "${destination}/Qt6QuickTemplates2d.dll" copied_sha)
if(NOT copied_sha STREQUAL sha)
    message(FATAL_ERROR "部署副本哈希不一致")
endif()
check_deployment("幂等重复部署" TRUE)
