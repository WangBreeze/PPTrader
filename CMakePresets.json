{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "vs2022-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vs2022-qt611",
      "displayName": "Windows x64 + Qt 6.11.2（可选）",
      "description": "PPTrader 默认目标：MSVC 2022 x64 + Qt 6.11.2。Qt 前缀由 cmake/PpQtToolchain.cmake 按版本解析（也可用 -DPPTRADER_QT_ROOT 指定）。Windows 上默认启用 APP-001 受控滚动条运行库校验。",
      "inherits": "vs2022-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.11.2"
      }
    },
    {
      "name": "vs2022-qt683",
      "displayName": "Windows x64 + Qt 6.8.3",
      "description": "项目内可选的 Qt 6.8.3 工具链。仅由本 preset 指定，不写入全局环境变量。",
      "inherits": "vs2022-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.8.3"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "linux-qt611-debug",
      "displayName": "Linux x64 + Qt 6.11.2 Debug（可选，需本机已装 6.11.2）",
      "description": "可选档位。2026-11-09 起默认目标改为 Qt 6.12.0（见 linux-qt612-debug）；本机 6.11.2 安装失败，此档位仅供已装该版本的环境使用。",
      "inherits": "linux-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.11.2",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-qt611-release",
      "displayName": "Linux x64 + Qt 6.11.2 RelWithDebInfo",
      "inherits": "linux-qt611-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "vs2022-qt612",
      "displayName": "Windows x64 + Qt 6.12.0（默认工具链）",
      "description": "2026-11-09 起的默认目标。Qt 固定取在线安装器装到 D:/ProgramData/Qt/6.12.0/msvc2022_64 的副本，不使用系统 Qt、不读取 Qt 相关环境变量；各版本须各自构建目录，禁止跨次版本混装。",
      "inherits": "vs2022-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.12.0"
      }
    },
    {
      "name": "linux-qt612-debug",
      "displayName": "Linux x64 + Qt 6.12.0 Debug（默认工具链）",
      "description": "2026-11-09 起的默认目标。Qt 固定取 ~/ProgramData/Qt/6.12.0/gcc_64（在线安装器副本），不使用发行版 /usr 的同名版本、不读取 Qt 相关环境变量；6.11.2 因安装失败不再作为基线，linux-qt611-* 仅供其它环境使用。",
      "inherits": "linux-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.12.0",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-qt612-release",
      "displayName": "Linux x64 + Qt 6.12.0 Release（默认工具链）",
      "inherits": "linux-qt612-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PPTRADER_QT_VERSION": "6.12.0"
      },
      "description": "与 linux-qt612-debug 相同前缀（~/ProgramData/Qt/6.12.0/gcc_64）的发布配置。"
    },
    {
      "name": "linux-qt683-debug",
      "displayName": "Linux x64 + Qt 6.8.3 Debug",
      "description": "项目内可选的 Qt 6.8.3 工具链，按平台约定位置（$HOME/ProgramData/Qt/6.8.3/gcc_64）解析。仅由本 preset 指定，不写入全局环境变量。",
      "inherits": "linux-base",
      "cacheVariables": {
        "PPTRADER_QT_VERSION": "6.8.3",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-qt683-release",
      "displayName": "Linux x64 + Qt 6.8.3 RelWithDebInfo",
      "inherits": "linux-qt683-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
