if(CONFIG STREQUAL "Debug")
    set(runtime_name "Qt6QuickTemplates2d.dll")
else()
    set(runtime_name "Qt6QuickTemplates2.dll")
endif()
set(runtime "${FIX_DIR}/${runtime_name}")
if(NOT EXISTS "${runtime}" OR NOT EXISTS "${runtime}.json")
    message(FATAL_ERROR "缺少${CONFIG}滚动条修复库或清单。先按cmake/qt-scrollbar-fix/README.md构建，禁止退回未经修复的库。")
endif()
file(READ "${runtime}.json" manifest)
string(JSON manifest_version GET "${manifest}" qtVersion)
string(JSON manifest_patch GET "${manifest}" patch)
string(JSON manifest_config GET "${manifest}" configuration)
string(JSON manifest_sha GET "${manifest}" runtimeSha256)
if(NOT manifest_version STREQUAL QT_VERSION OR NOT manifest_patch STREQUAL "APP-001-scrollbar-unique-connection-v1")
    message(FATAL_ERROR "Qt运行版本或补丁身份不一致")
endif()
if(CONFIG STREQUAL "Debug")
    if(NOT manifest_config STREQUAL "Debug")
        message(FATAL_ERROR "禁止混用Debug与Release运行库")
    endif()
elseif(NOT manifest_config MATCHES "^(Release|RelWithDebInfo)$")
    message(FATAL_ERROR "非Debug构建必须使用经过验收的Release系列运行库")
endif()
file(SHA256 "${runtime}" actual_sha)
if(NOT actual_sha STREQUAL manifest_sha)
    message(FATAL_ERROR "Qt修复库哈希与清单不一致")
endif()
file(MAKE_DIRECTORY "${TARGET_DIR}")
file(COPY_FILE "${runtime}" "${TARGET_DIR}/${runtime_name}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${runtime}.json" "${TARGET_DIR}/${runtime_name}.json" ONLY_IF_DIFFERENT)
string(REPLACE ".dll" ".pdb" symbols "${runtime}")
if(EXISTS "${symbols}")
    file(COPY "${symbols}" DESTINATION "${TARGET_DIR}")
endif()
